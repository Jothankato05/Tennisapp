{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "(command -v unzip >/dev/null || dnf install -y unzip) && (test -d .flutter || git clone --depth 1 --branch 3.47.7 https://github.com/flutter/flutter.git .flutter) && .flutter/bin/flutter --disable-analytics && .flutter/bin/flutter pub get",
  "buildCommand": ".flutter/bin/flutter build web --release --no-web-resources-cdn && find build/web -name '*.symbols' -delete",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(index.html|flutter_bootstrap.js|main.dart.js|manifest.json|version.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
